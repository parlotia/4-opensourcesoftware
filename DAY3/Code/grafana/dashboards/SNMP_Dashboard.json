      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "qyt-influxdb2"
          },
          "query": "from(bucket: \"qytdb\")                                         // 从名为\"qytdb\"的数据桶中读取数据\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)    // 根据仪表板设置的时间范围筛选数据\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"interface_table\") // 筛选接口表数据\r\n  |> filter(fn: (r) => r[\"_field\"] == \"ifInOctets\")           // 只保留入向字节数据\r\n  |> map(fn: (r) => ({ r with _value: r._value * 8 }))        // 将字节转换为位（乘以8）\r\n  |> derivative(unit: 1s, nonNegative: false)                 // 计算每秒变化率（即比特/秒）\r\n  |> filter(fn: (r) => r._value > 0)                          // 去除负数和0的值，避免数据异常\r\n  |> map(fn: (r) => ({                                        // 重新映射数据，添加自定义字段和测量名\r\n      r with \r\n      _field: \"InSpeed\",                                      // 修改字段名为InSpeed\r\n      _measurement: \"InSpeed \" + r.source + \" \" + r.ifDescr // 自定义图例，包含设备名和接口描述\r\n  }))\r\n  |> keep(columns: [\"_time\", \"_value\", \"_measurement\"])       // 只保留时间戳、速率值和自定义测量名\r\n  |> yield(name: \"derivative\")                                // 将结果命名为\"derivative\"以在图表中显示\r\n",
          "refId": "A"
        }
      ],
      "title": "路由器 接口速率入向",
      "type": "timeseries"
    },
