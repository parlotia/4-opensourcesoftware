      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "qyt-influxdb2"
          },
          "query": "from(bucket: \"qytdb\")                                         // 从名为\"qytdb\"的数据桶中读取数据\r\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)     // 根据仪表板设置的时间范围筛选数据\r\n  |> filter(fn: (r) =>                                        // 使用过滤器函数筛选特定的测量和字段\r\n    r._measurement == \"C8Kv_Snmp_v2c\" and                     // 筛选SNMP采集的思科路由器数据\r\n    (r._field == \"MemoryFree\" or r._field == \"MemoryUsed\")    // 同时获取空闲内存和已用内存数据\r\n  )\r\n  |> pivot(                                                   // 将多行数据透视为单行，便于计算内存利用率\r\n    rowKey:[\"_time\", \"source\"],                           // 按时间和主机名分组\r\n    columnKey: [\"_field\"],                                    // 将字段名作为列名\r\n    valueColumn: \"_value\"                                     // 将值放入对应列中\r\n  )\r\n  |> map(fn: (r) => ({                                        // 将字符串值转换为浮点数，以便进行数学计算\r\n    r with \r\n    MemoryFree: float(v: r.MemoryFree),\r\n    MemoryUsed: float(v: r.MemoryUsed)\r\n  }))\r\n  |> map(fn: (r) => ({                                            // 计算内存利用率：已用内存/(已用内存+空闲内存)*100%\r\n    r with \r\n    memory_utilization: r.MemoryUsed / (r.MemoryUsed + r.MemoryFree) * 100.0\r\n  }))\r\n  |> keep(columns: [\"_time\", \"source\", \"memory_utilization\"]) // 只保留时间戳、主机名和内存利用率\r\n  |> yield(name: \"memory_utilization\")                            // 将结果命名为\"memory_utilization\"以在图表中显示\r\n",
          "refId": "A"
        }
      ],
      "title": "路由器内存利用率",
      "type": "timeseries"
    },
