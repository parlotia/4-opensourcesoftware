      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "qyt-influxdb2"
          },
          "query": "from(bucket: \"qytdb\")                                         // 从名为\"qytdb\"的数据桶中读取数据\r\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)     // 根据仪表板设置的时间范围筛选数据\r\n  |> filter(fn: (r) =>                                        // 使用过滤器函数筛选特定的测量和字段\r\n    r._measurement == \"Cisco-IOS-XE-process-cpu-oper:cpu-usage/cpu-utilization\" and // 筛选通过gRPC采集的CPU数据\r\n    r._field == \"five_seconds\"                                // 只保留5秒平均CPU使用率数据\r\n  )\r\n  |> keep(columns: [\"_time\", \"_value\", \"source\"])             // 只保留时间戳、CPU值和源设备\r\n  |> yield(name: \"CPU_utilization\")                           // 将结果命名为\"CPU_utilization\"以在图表中显示\r\n",
          "refId": "A"
        }
      ],
      "title": "CPU利用率",
      "type": "timeseries"
    },
