      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "qyt-influxdb2"
          },
          "query": "from(bucket: \"qytdb\")                                         // 从名为\"qytdb\"的数据桶中读取数据\r\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)     // 根据仪表板设置的时间范围筛选数据\r\n  |> filter(fn: (r) =>                                        // 使用过滤器函数筛选特定的测量、字段和内存类型\r\n    r._measurement == \"Cisco-IOS-XE-memory-oper:memory-statistics/memory-statistic\" and r.name == \"Processor\" and // 筛选gRPC采集的处理器内存数据\r\n    (r._field == \"free_memory\" or r._field == \"total_memory\") // 同时获取空闲内存和总内存数据\r\n  )\r\n  |> pivot(                                                   // 将多行数据透视为单行，便于计算内存利用率\r\n    rowKey:[\"_time\", \"source\"],                               // 按时间和源设备分组\r\n    columnKey: [\"_field\"],                                    // 将字段名作为列名\r\n    valueColumn: \"_value\"                                     // 将值放入对应列中\r\n  )\r\n  |> map(fn: (r) => ({                                        // 将字符串值转换为浮点数，以便进行数学计算\r\n    r with \r\n    free_memory: float(v: r.free_memory),\r\n    total_memory: float(v: r.total_memory)\r\n  }))\r\n  |> map(fn: (r) => ({                                        // 计算内存利用率：空闲内存/总内存*100%（注意与SNMP计算方式不同）\r\n    r with \r\n    memory_utilization: r.free_memory / r.total_memory * 100.0\r\n  }))\r\n  |> keep(columns: [\"_time\", \"source\", \"memory_utilization\"]) // 只保留时间戳、源设备和内存利用率\r\n  |> yield(name: \"memory_utilization\")                        // 将结果命名为\"memory_utilization\"以在图表中显示\r\n",
          "refId": "A"
        }
      ],
      "title": "内存利用率",
      "type": "timeseries"
    },
